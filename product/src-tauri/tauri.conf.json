{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo All Studio",
  "version": "0.9.1",
  "identifier": "org.photoall.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-build"
  },
  "app": {
    "windows": [
      {
        "title": "Photo All Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#f5f5f3",
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:allow-close"]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../build/runtime/": "runtime/" },
    "licenseFile": "../LICENSE",
    "shortDescription": "Offline photo library, RAW development and film colour",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    }
  }
}
